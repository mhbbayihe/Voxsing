<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette relevée dans l'export PDF des écrans -->
    <Color x:Key="Primary">#5145CD</Color>
    <Color x:Key="Ink">#20243B</Color>
    <Color x:Key="Muted">#646B81</Color>
    <Color x:Key="Line">#D9E0EA</Color>
    <Color x:Key="Tint">#EEECFC</Color>
    <Color x:Key="OnPrimarySoft">#ECE9FF</Color>
    <Color x:Key="Success">#246B61</Color>
    <Color x:Key="SuccessTint">#E8F4EF</Color>
    <Color x:Key="NavMuted">#F7F8FC</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="BackgroundStart">#F6F8FB</Color>
    <Color x:Key="BackgroundEnd">#E9EFF8</Color>

    <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource BackgroundStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundEnd}" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
