<?xml version="1.0" encoding="utf-8" ?>
<!-- Écran 7 · Dictionnaire. -->
<ContentPage
    x:Class="VoxSign.Views.DictionaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:VoxSign.Controls"
    xmlns:m="clr-namespace:VoxSign.Models"
    xmlns:vm="clr-namespace:VoxSign.ViewModels"
    x:DataType="vm:DictionaryViewModel">

    <Grid RowDefinitions="*,Auto" IgnoreSafeArea="True">
        <ScrollView>
            <VerticalStackLayout Padding="24,0,24,22" Spacing="0">

                <c:ScreenHeader
                    Margin="0,61,0,0"
                    ShowBack="False"
                    Title="Dictionnaire"
                    Subtitle="Découvrir les repères en LSF"
                    ActionIcon="Sliders"
                    ActionText="Filtres"
                    ActionCommand="{Binding ShowFiltersCommand}" />

                <Border Style="{StaticResource Field}" HeightRequest="54" Margin="-1,24,-1,0">
                    <Grid>
                        <c:Icon Name="Search" Color="{StaticResource Muted}" Margin="18.2,17.2,0,0" />
                        <Entry
                            Text="{Binding SearchText}"
                            Placeholder="Rechercher un signe"
                            PlaceholderColor="{StaticResource Muted}"
                            FontFamily="InterRegular"
                            FontSize="15"
                            TextColor="{StaticResource Ink}"
                            VerticalOptions="Center"
                            Margin="50,0,16,0"
                            SemanticProperties.Description="Rechercher un signe" />
                    </Grid>
                </Border>

                <c:SegmentedFilter ItemsSource="{Binding Filters}" SelectCommand="{Binding SelectFilterCommand}" Margin="0,14,0,0" />

                <Grid Margin="0,15.55,0,0">
                    <Label Text="Les essentiels" Style="{StaticResource Section}" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding CatalogCount}" Style="{StaticResource SectionLink}" VerticalOptions="Start" Margin="0,2.85,0,0" />
                </Grid>

                <c:UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="14" Margin="0,14.65,0,0" BindableLayout.ItemsSource="{Binding Signs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:Sign">
                            <Border Style="{StaticResource Card}" SemanticProperties.Description="{Binding Word}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenSignCommand, Source={RelativeSource AncestorType={x:Type vm:DictionaryViewModel}}, x:DataType=vm:DictionaryViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Padding="10,10,10,11.1" Spacing="0">
                                    <Border Style="{StaticResource Photo}" HeightRequest="110">
                                        <Image Source="{Binding Image}" />
                                    </Border>
                                    <Grid Margin="0,8.55,0,0">
                                        <Label Text="{Binding Word}" Style="{StaticResource CardTitle}" LineBreakMode="TailTruncation" Margin="0,0,24,0" />
                                        <Grid WidthRequest="32" HeightRequest="20.5" HorizontalOptions="End" VerticalOptions="Start" Margin="0,0,-6,0" SemanticProperties.Description="Favori">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type vm:DictionaryViewModel}}, x:DataType=vm:DictionaryViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <c:Icon Name="Bookmark" Color="{StaticResource Primary}" Margin="9.7,1.95,0,0">
                                                <c:Icon.Triggers>
                                                    <DataTrigger TargetType="c:Icon" Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Name" Value="BookmarkCheck" />
                                                    </DataTrigger>
                                                </c:Icon.Triggers>
                                            </c:Icon>
                                        </Grid>
                                    </Grid>
                                    <Label Text="{Binding Category}" FontSize="12" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" Margin="0,9.25,0,0" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </c:UniformGrid>

                <HorizontalStackLayout Spacing="0" Margin="0,16.4,0,0">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenOfflineCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <c:Icon Name="CheckCircle" Color="{StaticResource Primary}" Margin="1,0,0,0" />
                    <Label Text="{Binding OfflineCount}" FontSize="13" TextColor="{StaticResource Primary}" Margin="9,0,0,0" />
                </HorizontalStackLayout>

                <c:InfoNote Variant="Outline" Margin="0,16.6,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <c:BottomNav Grid.Row="1" Active="Dictionnaire" Variant="Outlined" Command="{Binding NavigateTabCommand}" />
    </Grid>
</ContentPage>
